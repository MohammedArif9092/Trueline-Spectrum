generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("EDITOR")
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  articles     Article[]  @relation("AuthoredByAdmin")
  auditLogs    AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  section     String    @default("news")
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([section])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  articles  ArticleTag[]
}

model Author {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  title     String?
  bio       String?
  avatar    String?
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Article {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  subtitle       String?
  excerpt        String?
  content        String
  featuredImage  String?
  imageCaption   String?
  authorId       String?
  createdById    String?
  categoryId     String?
  status         String       @default("DRAFT")
  featured       Boolean      @default(false)
  trending       Boolean      @default(false)
  premium        Boolean      @default(false)
  priority       Int          @default(0)
  readingMinutes Int          @default(4)
  views          Int          @default(0)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  author         Author?      @relation(fields: [authorId], references: [id])
  category       Category?    @relation(fields: [categoryId], references: [id])
  createdBy      Admin?       @relation("AuthoredByAdmin", fields: [createdById], references: [id])
  tags           ArticleTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([trending])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Research {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  summary          String
  content          String?
  researchCategory String    @default("research")
  institution      String?
  researchers      String?
  publicationInfo  String?
  featuredImage    String?
  relatedArticleId String?
  status           String    @default("DRAFT")
  featured         Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([researchCategory])
  @@index([status])
}

model Event {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  startDate       DateTime
  endDate         DateTime?
  time            String?
  location        String?
  mode            String    @default("in-person")
  description     String
  organizer       String?
  registrationUrl String?
  image           String?
  category        String    @default("conference")
  status          String    @default("DRAFT")
  featured        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, startDate])
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  type         String   @default("university")
  logo         String?
  coverImage   String?
  description  String?
  location     String?
  website      String?
  contactEmail String?
  contactPhone String?
  founded      String?
  achievements String?
  status       String   @default("PUBLISHED")
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([status])
}

model Magazine {
  id           String         @id @default(cuid())
  editionTitle String
  slug         String         @unique
  month        String
  year         Int
  coverImage   String
  description  String?
  theme        String?
  status       String         @default("DRAFT")
  isCurrent    Boolean        @default(false)
  featured     Boolean        @default(false)
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  pages        MagazinePage[]

  @@index([status, year, month])
}

model MagazinePage {
  id         String   @id @default(cuid())
  magazineId String
  pageNumber Int
  title      String?
  image      String?
  body       String?
  isSection  Boolean  @default(false)
  createdAt  DateTime @default(now())
  magazine   Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)

  @@unique([magazineId, pageNumber])
  @@index([magazineId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  filename  String
  alt       String?
  mimeType  String?
  width     Int?
  height    Int?
  size      Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Advertisement {
  id        String   @id @default(cuid())
  name      String
  placement String   @default("sidebar")
  imageUrl  String?
  linkUrl   String?
  html      String?
  active    Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, active])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
}

model PremiumPlan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  priceLabel  String
  interval    String?
  tagline     String?
  features    String
  highlighted Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  subtitle  String?
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  config    String?
  updatedAt DateTime @updatedAt
}

model TickerItem {
  id        String   @id @default(cuid())
  label     String
  href      String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
